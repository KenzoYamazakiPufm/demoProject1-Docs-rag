# pkdb 配置示例 —— 复制为 .env 后填上自己的 Key 即可
#     PowerShell:  Copy-Item .env.example .env
#
# 设计原则：所有供应商都走 OpenAI 兼容协议，
# 换厂商只需要改下面三行（base_url / model / key），代码一行都不用动。
#
# 没有 Key 也能用：build 时只入库不做向量化，search/ask 会自动降级为
# 「关键词检索 + 片段罗列」，方便先验证检索质量。


# ============================================================
# 1) 向量化（embedding）—— 默认：硅基流动 SiliconFlow
#    注册：https://siliconflow.cn  需实名认证，免费模型无需信用卡
# ============================================================
PKDB_EMBED_BASE_URL=https://api.siliconflow.cn/v1
# ⚠️ 计费陷阱：`BAAI/bge-m3` 免费，`Pro/BAAI/bge-m3` 按量收费（约 ¥0.07/百万 token）
#    务必使用**不带 Pro/ 前缀**的模型 ID。
PKDB_EMBED_MODEL=BAAI/bge-m3
PKDB_EMBED_API_KEY=

# bge-m3 的向量维度。换成别的模型（如 bge-large-zh-v1.5 是 1024、
# text-embedding-3-small 是 1536）时，改这里并重跑 build --force 重建向量。
PKDB_EMBED_DIM=1024

# 每条请求携带多少文本（批量请求可以大幅减少调用次数）
PKDB_EMBED_BATCH=32

# 低于该字数的块不送去向量化（例如只有板块标题的块），省免费额度
PKDB_EMBED_MIN_CHARS=10


# ============================================================
# 2) 重排（rerank）—— 默认：硅基流动，可整体关闭
# ============================================================
PKDB_RERANK_ENABLED=1
PKDB_RERANK_BASE_URL=https://api.siliconflow.cn/v1
PKDB_RERANK_MODEL=BAAI/bge-reranker-v2-m3
PKDB_RERANK_API_KEY=


# ============================================================
# 3) 对话模型（语言组织）
# ============================================================
# --- ⭐ 方案 A（推荐）：仍用硅基流动 —— 一把 Key 全搞定，无需再注册别家
#     2026-09-19 实测：Qwen/Qwen2.5-7B-Instruct 免费、可用、约 0.4 秒响应。
#     三处 API Key 填成同一把即可（显式写三遍，避免"拿错 Key 去调别家"的困惑）。
PKDB_LLM_BASE_URL=https://api.siliconflow.cn/v1
PKDB_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
PKDB_LLM_API_KEY=
#     同平台其它免费对话模型（按需替换上面那行）：
#       THUDM/GLM-4-9B-0414            32K   响应快
#       THUDM/GLM-Z1-9B-0414           128K  推理型
#       Qwen/Qwen3.5-4B                256K  上下文最长
#       deepseek-ai/DeepSeek-R1-0528-Qwen3-8B   推理型（较慢）

# --- 方案 B：智谱 GLM（免费 Flash 系列）
#     注册：https://open.bigmodel.cn  手机号即可
# PKDB_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# PKDB_LLM_MODEL=glm-4-flash
# PKDB_LLM_API_KEY=

# --- 方案 C：DeepSeek（没有免费额度，但极便宜、回答质量明显更好）
#     注册：https://platform.deepseek.com  充值后才有余额（无免费层）
#     实测成本：约 0.005 元/次问答（flash 系列，空闲时段）
#     空闲时段 = 周末全天 + 工作日 9:00-12:00 / 14:00-18:00 之外
# PKDB_LLM_BASE_URL=https://api.deepseek.com
# PKDB_LLM_MODEL=deepseek-flash
# PKDB_LLM_API_KEY=
#
#     ⚠️ DeepSeek 建议**一定**补上下面这一行（其它厂商不需要）：
#        官方文档明确「思考模式默认打开，且 effort 默认为 high」。
#        不关掉的话，每次问答都会先想一遍：明显变慢、思考 token 按输出计费，
#        而且**思考模式下 temperature 会被静默忽略**（传了也不生效、还不报错）。
#        想让它更聪明就删掉这行或改成 "enabled"，代价是每次问答多等好几秒。
# PKDB_LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

PKDB_LLM_TIMEOUT=60
PKDB_LLM_MAX_TOKENS=1024
PKDB_LLM_TEMPERATURE=0.2


# ============================================================
# 4) 检索与免费额度保护
# ============================================================
# 最终返回给用户 / 大模型的片段数
PKDB_TOP_K=5

# RRF 融合后保留的候选数（rerank 只在这批候选上跑，控制成本）
PKDB_FUSION_TOP_K=20

# RRF 公式里的 k（越大越"削峰"，默认 60 是论文推荐值）
PKDB_RRF_K=60

# 喂给大模型时回溯父块的上限：父块（整个板块）超过这个字数就只用子块原文
PKDB_PARENT_CONTEXT_MAX_CHARS=600

# 降级输出里每条片段截断长度
PKDB_FALLBACK_SNIPPET_CHARS=200

# 单次运行的 API 调用上限，防止误触发把免费额度刷爆
PKDB_MAX_API_CALLS=200

# 429 / 5xx 指数退避重试次数（退避序列 1/2/4/8 秒）
PKDB_RETRY_MAX=3
